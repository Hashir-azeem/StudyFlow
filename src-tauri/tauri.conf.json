{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyFlow",
  "version": "../package.json",
  "identifier": "app.studyflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudyFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "StudyFlow",
    "category": "Education",
    "shortDescription": "A friction-free student scheduler",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4NTJDOUM3NzM4QzE0RkYKUldUL0ZJeHp4OGxTaURnY3p5MjkwWHZjeG5rUVNGR0tRZTRuQ0tka3FBeHd1c0xWNWV3WnRhWG0K",
      "endpoints": [
        "https://github.com/Hashir-azeem/StudyFlow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
